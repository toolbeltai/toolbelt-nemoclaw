# Env contract for the quickstart-based deploy. See docs/local-dev-deploy.md.
# Copy to .env and fill in. Never commit real tokens or keys.

# --- Toolbelt ---
# Provide a token to bind an existing account; leave unset for anonymous onboarding
# during `toolbelt install`.
TOOLBELT_TOKEN=
# Toolbelt instance host (optional; @toolbeltai/cli defaults to app.toolbelt.ai).
# Set for self-hosted / edge instances.
TOOLBELT_HOST=app.toolbelt.ai

# --- NemoClaw onboarding (non-interactive) ---
NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1
NEMOCLAW_SANDBOX_NAME=toolbelt
# Allowlist the Toolbelt MCP host via the toolbelt egress preset (supplied through a
# custom blueprint). See docs/local-dev-deploy.md, caveat 1.
NEMOCLAW_POLICY_PRESETS=toolbelt
# NEMOCLAW_BLUEPRINT_PATH=/path/to/blueprint

# --- Inference provider ---
# This example uses Anthropic + Claude Haiku (cheap, fast). The key needs a non-zero
# credit balance (a $0 balance fails provider validation with HTTP 400).
NEMOCLAW_PROVIDER=anthropic
NEMOCLAW_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
