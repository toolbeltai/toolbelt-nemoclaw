# Config for demo-shared-brain.sh — the "two users, one shared brain" NemoClaw demo.
# Copy/edit as needed; demo-shared-brain.sh loads this and provision.sh inherits it.
# Do NOT set TOOLBELT_TOKEN here: the demo provisions two fresh users and injects
# each token per sandbox (inline env wins over this file).

# --- Demo roles (one sandbox each; the first owns the shared namespace) ---
OWNER_ROLE=scheduler
PEER_ROLE=csr

# --- Inference: Nemotron on NVIDIA (NemoClaw's native path) ---
# build = NVIDIA hosted endpoints; use `nim` instead if you have a local GPU NIM.
NEMOCLAW_PROVIDER=build
# The model must be (a) deployed for YOUR account and (b) tool-calling capable, or the
# Toolbelt MCP server is dead weight and the shared-brain coordination fails. Catalog
# membership is not enough; models can be account/org-gated (a non-deployed model 404s at
# onboard). Verified tool-calling on our account: nvidia/llama-3.3-nemotron-super-49b-v1
# (default below), nvidia/nemotron-3-super-120b-a12b, nvidia/nvidia-nemotron-nano-9b-v2
# (cheapest). Confirm availability for your own key (list: GET integrate.api.nvidia.com/v1/models).
NEMOCLAW_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NEMOCLAW_PROVIDER_KEY=

# --- NemoClaw onboarding (non-interactive) ---
NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1

# Toolbelt control-plane host (where users are provisioned + shared). Default works.
# TOOLBELT_HOST=https://app.toolbelt.ai
