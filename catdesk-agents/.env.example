# Cat-desk agents: env contract. cp .env.example .env, fill in the keys. NEVER commit real keys.

NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1
NEMOCLAW_SANDBOX_NAME=toolbelt-catdesk

# Nemotron 3 Super on NVIDIA's hosted endpoint. Re-verified 2026-10-06 through the Chat Completions
# API: clean tool calls, and reasoning arrives in its own field instead of leaking into answers.
# (meta/llama-3.3-70b-instruct, the shared-brain demo's old default, was retired on 2026-08-26.)
NEMOCLAW_PROVIDER=build
NEMOCLAW_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOCLAW_PROVIDER_KEY=
NEMOCLAW_AGENT_HEARTBEAT_EVERY=0m

# The shared brain: the Insurance Peril Exposure namespace, and a Toolbelt token with write access.
TOOLBELT_NAMESPACE=664f9ed5-a82e-4908-92bb-d5d209f5fb1c
TOOLBELT_TOKEN=
