# Toolbelt shared-brain demo — env contract. Copy to .env and fill in keys. NEVER commit real keys
# (.env is gitignored). On a fresh box: cp .env.example .env, set the key(s), then ./scripts/setup.sh.

# --- NemoClaw onboarding (non-interactive) ---
NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1
NEMOCLAW_SANDBOX_NAME=toolbelt-shared-brain

# --- Inference provider ---
# DEFAULT: meta/llama-3.3-70b-instruct via build.nvidia.com (no local GPU). Served from NVIDIA's
# endpoint (integrate.api.nvidia.com), so this stays a NemoClaw/NVIDIA demo, but it is a NON-REASONING
# instruct model — which is what this agent workload needs (terse structured tool-calls + a short
# synthesis). VERIFIED end-to-end: watch -> exposure -> comms all run clean and comms produces + saves
# a grounded situation brief.
#
# WHY NOT Nemotron here: the Nemotron 3 REASONING models (super-120b, nano-omni-...-reasoning) leak
# their chain-of-thought as the answer on the free build tier — the tool-calling turns can be forced
# to behave with `--thinking off`, but the free-form synthesis turn (comms) degenerates (token salad /
# reasoning-only / repetition loops) regardless of tuning. NemoClaw's reasoning:false does NOT force
# thinking off at inference time for the managed NVIDIA provider. So a non-reasoning model is required
# for the full pipeline. If you switch to a Nemotron reasoning model, expect the comms turn to fail.
NEMOCLAW_PROVIDER=build
NEMOCLAW_MODEL=meta/llama-3.3-70b-instruct
# build.nvidia.com key. NEMOCLAW_PROVIDER_KEY is the generic credential NemoClaw reads for the
# selected provider. Put your nvapi-... key here:
NEMOCLAW_PROVIDER_KEY=

# Disable the agent heartbeat: the periodic HEARTBEAT.md prompt makes some models loop on a code tool.
NEMOCLAW_AGENT_HEARTBEAT_EVERY=0m

# --- Alternative: Anthropic Claude Haiku ---
# Also a reliable non-reasoning tool-caller. Set these and clear the build ones above to use it (the
# #976 patch is a no-op for non-build providers, so setup.sh skips it). Off-brand for a NVIDIA demo.
#   NEMOCLAW_PROVIDER=anthropic
#   NEMOCLAW_MODEL=claude-haiku-4-5
#   NEMOCLAW_PROVIDER_KEY=                              # your Anthropic sk-ant-... key

# --- Toolbelt (the shared brain) ---
# Leave TOOLBELT_TOKEN unset for anonymous onboarding during `toolbelt install`, or set one to bind an
# existing account. setup.sh adopts the datasets into the selected namespace and pins that
# namespace_id into the agent personas (the tools require an explicit namespace_id on every call).
TOOLBELT_TOKEN=
# Include the scheme — a bare host throws "Failed to parse URL" in the Toolbelt CLI.
TOOLBELT_HOST=https://app.toolbelt.ai

# Which namespace the agents use (the shared brain). Optional:
#   - a namespace id (UUID)  -> used directly
#   - a namespace name       -> resolved to its id, created if it doesn't exist yet
#   - unset                  -> the token's default (the just-onboarded one for an anonymous token,
#                               else "Default Workspace", else the oldest namespace)
# The token must own or have shared access to the chosen namespace.
TOOLBELT_NAMESPACE=

# Public datasets adopted into the namespace (the brain). Names are catalog assets.
TOOLBELT_PUBLIC_ASSETS="NWS Active Weather Alerts;US Census Blocks 2024;US Building Footprints"
