# Toolbelt shared-brain demo — env contract. Copy to .env and fill in keys. NEVER commit real keys
# (.env is gitignored). On a fresh box: cp .env.example .env, set the key(s), then ./scripts/setup.sh.

# --- NemoClaw onboarding (non-interactive) ---
NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1
NEMOCLAW_SANDBOX_NAME=toolbelt-shared-brain

# --- Inference provider ---
# DEFAULT: Anthropic Claude Haiku — reliable, fast tool-calling (recommended for this demo).
# The agents are terse tool-callers; Haiku follows that cleanly where smaller/reasoning models loop.
NEMOCLAW_PROVIDER=anthropic
NEMOCLAW_MODEL=claude-haiku-4-5
# Anthropic API key. NEMOCLAW_PROVIDER_KEY is the generic credential NemoClaw reads for the selected
# provider (equivalently you can set ANTHROPIC_API_KEY). Put your sk-ant-... key here:
NEMOCLAW_PROVIDER_KEY=

# Disable the agent heartbeat: the periodic HEARTBEAT.md prompt makes some models loop on a code tool.
NEMOCLAW_AGENT_HEARTBEAT_EVERY=0m

# --- Alternative provider: NVIDIA Nemotron via build.nvidia.com (no local GPU) ---
# To use NVIDIA instead, set these and clear the Anthropic ones above. NOTE: Nemotron (a reasoning
# MoE) is far less reliable at terse tool-calling here, and the free build tier can be slow.
# setup.sh auto-applies the #976 build-provider tool-call patch ONLY when NEMOCLAW_PROVIDER=build.
#   NEMOCLAW_PROVIDER=build
#   NEMOCLAW_MODEL=meta/llama-3.3-70b-instruct        # or nvidia/nemotron-3-super-120b-a12b
#   NEMOCLAW_PROVIDER_KEY=                              # your build.nvidia.com (nvapi-...) key

# --- Toolbelt (the shared brain) ---
# Leave TOOLBELT_TOKEN unset for anonymous onboarding during `toolbelt install`, or set one to bind an
# existing account. setup.sh resolves the default namespace, adopts the datasets, and pins the
# resolved namespace_id into the agent personas (the token may have multiple namespaces, so the MCP
# can't auto-resolve a default — the tools require an explicit namespace_id).
TOOLBELT_TOKEN=
# Include the scheme — a bare host throws "Failed to parse URL" in the Toolbelt CLI.
TOOLBELT_HOST=https://app.toolbelt.ai

# Public datasets adopted into the namespace (the brain). Names are catalog assets.
TOOLBELT_PUBLIC_ASSETS="NWS Active Weather Alerts;US Census Blocks 2024;US Building Footprints"
