# Toolbelt shared-brain demo — env contract. Copy to .env. Never commit real keys.

# --- NemoClaw onboarding (non-interactive) ---
NEMOCLAW_NON_INTERACTIVE=1
NEMOCLAW_ACCEPT_THIRD_PARTY_SOFTWARE=1
NEMOCLAW_SANDBOX_NAME=toolbelt-shared-brain

# --- Inference: Nemotron via build.nvidia.com (no local GPU) ---
NEMOCLAW_PROVIDER=build
NEMOCLAW_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1   # any Nemotron that supports TOOL CALLING
NEMOCLAW_PROVIDER_KEY=                                   # your build.nvidia.com API key

# --- Toolbelt (the shared brain) ---
# Leave TOOLBELT_TOKEN unset for anonymous onboarding during `toolbelt install`, or set one to
# bind an existing account. setup.sh creates the namespace + adopts the datasets and fills
# TOOLBELT_NAMESPACE into openclaw.json.
TOOLBELT_TOKEN=
# Include the scheme — a bare host (app.toolbelt.ai) throws "Failed to parse URL" in the
# Toolbelt CLI. setup.sh normalizes it, but keep it correct here.
TOOLBELT_HOST=https://app.toolbelt.ai

# Public datasets adopted into the namespace (the brain). Names are catalog assets.
TOOLBELT_PUBLIC_ASSETS="NWS Active Weather Alerts;US Census Blocks 2024;US Building Footprints"
